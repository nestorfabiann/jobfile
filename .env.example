# Supabase: Project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public address of the app, used in email and text links
APP_URL=http://localhost:3000

# Email (resend.com). The from address must use a domain you verified in Resend.
RESEND_API_KEY=re_xxx
EMAIL_FROM=Jobfile <notifications@yourdomain.com>

# Text messages (twilio.com). Leave blank to turn SMS off.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15125550100

# Price check (homeowner AI price reference). Leave off to hide the feature.
PRICE_CHECK_ENABLED=false
ANTHROPIC_API_KEY=
# PRICE_CHECK_MODEL=claude-sonnet-5-5

# Admin panel: comma-separated emails allowed into /admin. Leave empty to turn the panel off.
ADMIN_EMAILS=

# Message translation (English and Spanish). Uses the same ANTHROPIC_API_KEY as Price check.
TRANSLATE_ENABLED=false
# TRANSLATE_MODEL=claude-haiku-5-5

# Ratings: set true to show contractors a private score summary of a homeowner's past projects. Off by default.
HOMEOWNER_RATINGS_VISIBLE=false
